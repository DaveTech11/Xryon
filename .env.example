# =====================================================================
# XYRON SETTINGS - edit the values after the "=" then restart the server
# (npm run server) and the dev site (npm run dev).
# Do NOT share or upload this file. It is listed in .gitignore.
# =====================================================================

# ---------- 1. Server ----------
# Port the backend runs on. Keep 3000 unless you also change vite.config.js
PORT=3000
# development = the email code is also printed in the server console (handy for testing)
# production  = use this on your live site
NODE_ENV=development
# Where users open the site, NO slash at the end.
#   testing on your computer:  http://localhost:5173
#   live site:                 https://your-site.com
PUBLIC_URL=http://localhost:5173
# Max requests per minute from one visitor
RATE_LIMIT_PER_MINUTE=120

# ---------- 2. Admins ----------
# Emails that can use /admin, broadcasts and Codex (comma separated, no spaces needed).
# The server uses ADMIN_EMAILS. VITE_ADMIN_EMAILS controls which admin screens
# show in the app - keep both the same.
ADMIN_EMAILS=you@example.com
VITE_ADMIN_EMAILS=you@example.com

# ---------- 3. Continue with Google ----------
# Get both from console.cloud.google.com -> Credentials -> OAuth client ID (Web).
# Redirect URI to add there:  PUBLIC_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- 4. Email codes (sign-up / sign-in) ----------
# Your Formspree form. Codes are sent here (no SMTP).
FORMSPREE_ENDPOINT=https://formspree.io/f/mppqqzrk
# Leave empty to really send. Put "console" to only print codes in the server console.
EMAIL_TRANSPORT=

# ---------- 5. AI providers ----------
# Premium chat: Vortyx Pulse API key.
VORTYX_API_URL=https://vortyx-pulse-backend.onrender.com/v1
VORTYX_API_KEY=

# Image generation: Google Gemini ("nano banana"). Paste your Google API key here.
# Keys starting with AQ. (Google Cloud / Vertex express) and AIza (AI Studio) both work.
# If generation fails for any reason, users see the upgrade popup (never the raw error);
# the real reason is printed in the server console.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Comma separated models to try if the first is unavailable
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image-preview
# auto | gemini | vertex  (auto picks by key prefix and tries the other as a backup)
GEMINI_IMAGE_ENDPOINT=auto

# Pollinations (gen.pollinations.ai): used only for /wallpaper /3d /pixel /sticker /watercolor /oilpaint /sketch /cartoon
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=

# Hugging Face: used only for /anime /manga /cyberpunk /fantasy /neon
HF_TOKEN=
HF_IMAGE_MODEL=

# Optional OpenAI key (chat + image generation). Empty = not used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=

# Free providers (api-rebix)
GPTLOGIC_API_URL=https://api-rebix.vercel.app/api/gptlogic
DEEPSEEK_API_URL=https://api-rebix.vercel.app/api/deepseek-v3
# Reads images users upload (needs the site to be public)
GEMINI_API_URL=https://api-rebix.vercel.app/api/gemini

# Codex model names (only used when Codex is open to users)
MODEL_VORTYX_PULSE=
MODEL_XYRON_SWIFT=
MODEL_XYRON_NEXUS=
MODEL_XYRON_LUNA=
MODEL_XYRON_VISION=

# ---------- 6. Extras ----------
# Let the Codex terminal run JavaScript for non-admins (keep false)
ENABLE_CODE_RUNNER=false

# ---------- 7. Database (Render PostgreSQL) ----------
# Paste your Render Postgres "Internal Database URL" here when the server runs on
# Render (or the "External" one from your computer). Empty = use local data/xyron.json.
# With this set, accounts, chats and uploaded files survive redeploys.
DATABASE_URL=

# ---------- 8. Premium payments ----------
# Premium = 5,000 NGN / 30 days, Premium+ = 10,000 NGN / 30 days. Plans activate only after the
# provider confirms the payment to the server. Leave a method's keys empty to show it as
# "Not available yet". PUBLIC_URL (section 1) must be your real https address in production.

# Flutterwave (v3 hosted checkout). Dashboard -> Settings -> API: v3 SECRET key (FLWSECK-...).
# Dashboard -> Settings -> Webhooks: URL = PUBLIC_URL/api/payments/webhook/flutterwave and
# "Secret hash" = the same value as FLW_SECRET_HASH below (you invent it).
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# OPay (Cashier). OPay merchant dashboard -> API Keys & Webhooks.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
# live (default) or sandbox
OPAY_ENV=

# Crypto via NOWPayments (BTC, ETH, USDT, ...). nowpayments.io -> Store settings.
# IPN callback URL is sent automatically: PUBLIC_URL/api/payments/webhook/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Crypto prices in USD (the NGN prices above are fixed)
CRYPTO_PRICE_PREMIUM_USD=4
CRYPTO_PRICE_PREMIUM_PLUS_USD=8

# --- Free AI providers: automatic switching ---
# The free api-rebix endpoints are tried in this order. If one has not answered after
# FREE_AI_SWITCH_MS the next one is asked too (first good answer wins); one that fails or
# times out is skipped for 60 seconds.
# FREE_AI_ORDER=gptlogic,claude-haiku,claude-session,deepseek-v3
# FREE_AI_SWITCH_MS=6000
# FREE_AI_TIMEOUT_MS=25000
# VORTYX_TIMEOUT_MS=20000
# OPENAI_TIMEOUT_MS=30000

# --- Image generation ---
# One or more Hugging Face models, tried in order (a model the provider reports as removed is skipped).
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Keyless last-resort text-to-image when every configured provider failed. Set to "off" to disable.
# FREE_IMAGE_FALLBACK=on

# ---------- Image search (pictures under AI answers) ----------
# Optional. With NO key, Xyron still finds pictures (Openverse + Wikimedia Commons), but
# the keys below give nicer, higher-quality photos. Keys stay on the server and are never
# sent to the browser. The first provider that has a key and returns pictures is used,
# in this order: Pexels, Unsplash, Pixabay, SerpAPI (Google Images).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
SERPAPI_KEY=
# How long to wait for an image provider (milliseconds)
IMAGE_SEARCH_TIMEOUT_MS=9000

# ---------- ZIP projects in chat ----------
# How many characters of an attached ZIP's files the AI is shown (bigger = more of your project).
ZIP_CONTEXT_CHARS=60000

# ---------- AI backup switching ----------
# The free AI providers (gptlogic, claude-haiku, claude-session, deepseek-v3 from api-rebix) are
# tried in this order. If one has not answered after FREE_AI_SWITCH_MS, the next one is asked too
# and whichever answers first wins. FREE_AI_TIMEOUT_MS is when a single provider is given up on.
FREE_AI_ORDER=gptlogic,claude-haiku,claude-session,deepseek-v3
FREE_AI_SWITCH_MS=3500
FREE_AI_TIMEOUT_MS=20000
